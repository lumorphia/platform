{
  "name": "@lumorphia/legal",
  "version": "1.0.0",
  "description": "規約とプライバシーポリシーの本文の読み取りと表示、同意した版と今の版の比較。ブラウザでも動く",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumorphia/platform.git",
    "directory": "packages/legal"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "marked": "^18.0.14"
  }
}
